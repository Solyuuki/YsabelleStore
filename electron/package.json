{
  "name": "@ysabellestore/electron",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc -p tsconfig.json && esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/index.cjs",
    "package": "electron-builder --config electron-builder.config.cjs",
    "lint": "eslint src electron-builder.config.cjs",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electron": "^42.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "esbuild": "^0.25.12",
    "electron-builder": "^26.15.3",
    "tsx": "^4.19.2"
  }
}
