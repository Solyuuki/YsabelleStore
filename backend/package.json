{
  "name": "@ysabellestore/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prisma:generate": "npm run prisma:generate --prefix ..",
    "prebuild": "npm run prisma:generate",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test --test-concurrency=1 test/data-flow.test.ts test/forecast-delivery.test.ts test/forecast-fallback.test.ts test/historical-sales-rules.test.ts test/inventory-import.test.ts",
    "start": "node dist/src/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "read-excel-file": "^9.3.1",
    "saxen": "^11.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2"
  }
}
