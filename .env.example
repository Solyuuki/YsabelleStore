# ============================================================================== 
# YsabelleStore - Local Development Environment
# ============================================================================== 

# Application
APP_ENV=development
ELECTRON_APP_NAME=YsabelleStore

# Application URLs
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3001

# Database
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=ysabellestore
DATABASE_USERNAME=root
DATABASE_PASSWORD=Password
DATABASE_URL=mysql://root:Password@localhost:3306/ysabellestore

# Browser, Vite production-preview, and Electron renderer origins allowed by the backend.
# "null" is the packaged Electron file:// renderer origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,null
JWT_SECRET=change_this_development_secret

# Forecasting performance guards.
# Full rebuilds use up to four workers. The backend scales its process timeout from the product
# count and per-product SARIMA budget so a legitimate cold rebuild is not killed at 120 seconds.
FORECAST_WORKERS=4
FORECAST_PROCESS_TIMEOUT_MS=120000
# One product may spend at most this many seconds inside SARIMA fitting before fallback is used.
SARIMA_FIT_TIMEOUT_SECONDS=8

# Customer email OTP/password recovery delivery. Keep real credentials only in local/host secrets.
# Production delivery uses Resend.
RESEND_API_KEY=
CUSTOMER_RECOVERY_FROM_EMAIL=
# Development-only Gmail SMTP delivery for Register and Login OTP QA.
# Use a Gmail account with 2-Step Verification and a Google App Password.
# OTP is sent to the actual email entered in the app; these credentials only identify the sender.
CUSTOMER_DEV_GMAIL_SMTP_USER=
CUSTOMER_DEV_GMAIL_SMTP_APP_PASSWORD=

# Customer social authentication.
# Never commit real Google/Meta credentials. Put real values only in local/host secrets.
CUSTOMER_OAUTH_PUBLIC_BACKEND_URL=http://localhost:3001
CUSTOMER_OAUTH_TRANSACTION_KEY=replace_with_a_random_secret_at_least_32_characters
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_APP_ID=
FACEBOOK_OAUTH_APP_SECRET=
FACEBOOK_GRAPH_API_VERSION=v26.0

# Optional Inventory Recommender AI assistant.
# Leave unset to use the deterministic recommender only.
RECOMMENDER_AI_PROVIDER=auto
RECOMMENDER_AI_TIMEOUT_MS=4000
CLOUDFLARE_AI_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_MODEL=
GROQ_API_KEY=
GROQ_AI_MODEL=

# Customer Support
# The support mailbox receives customer replies and sends staff responses through the Gmail API.
# Gmail authorization reuses GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET above.
# Create the refresh token with offline access and Gmail send/read scopes. Never commit the token.
CUSTOMER_SUPPORT_EMAIL=
CUSTOMER_SUPPORT_FROM_NAME=Ysabelle Store Customer Support
GOOGLE_GMAIL_REFRESH_TOKEN=
