# ==============================================================================
# YsabelleStore - Local Development Environment
# ==============================================================================

# Application
APP_ENV=development
NODE_ENV=development
ELECTRON_APP_NAME=YsabelleStore

# Application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173

# Docker MySQL
MYSQL_DATABASE="ysabelle_store"
MYSQL_USER="ysabelle_user"
MYSQL_PASSWORD="ysabelle_password"
MYSQL_ROOT_PASSWORD="ysabelle_root_password"

# Database / Prisma
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME="ysabelle_store"
DATABASE_USERNAME="ysabelle_user"
DATABASE_PASSWORD="ysabelle_password"
DATABASE_URL="mysql://ysabelle_user:ysabelle_password@localhost:3306/ysabelle_store"

# Backend
PORT=3001
JWT_SECRET=change_this_development_secret
