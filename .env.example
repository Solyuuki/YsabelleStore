# ==============================================================================
# YsabelleStore - Local Development Environment
# ==============================================================================

# Application
APP_ENV=development
NODE_ENV=development
ELECTRON_APP_NAME=YsabelleStore

# Application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=ysabellestore
DATABASE_USERNAME=root
DATABASE_PASSWORD=your_mysql_password
DATABASE_URL="mysql://root:your_mysql_password@localhost:3306/ysabellestore"

# Backend
PORT=3001
JWT_SECRET=change_this_development_secret
