{
  "name": "ysabellestore",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop inventory recommender system for Ysabelle's Store.",
  "workspaces": [
    "frontend",
    "backend",
    "electron"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "node --env-file=.env scripts/dev.mjs",
    "dev:web": "node --env-file=.env scripts/dev.mjs --web-only",
    "dev:lifecycle-test": "node --env-file=.env scripts/dev-lifecycle-smoke.mjs",
    "build": "npm run build --workspaces && npm run prisma:validate",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "healthcheck": "node scripts/healthcheck.mjs",
    "runtime:report": "node --env-file=.env scripts/runtime-report.mjs",
    "storefront:parity": "node --env-file=.env scripts/storefront-parity.mjs",
    "inventory:audit": "node scripts/inventory-audit.mjs",
    "inventory:reconcile": "tsx scripts/inventory-reconcile.mjs",
    "prisma:clean": "node scripts/prisma-clean.mjs",
    "artifact-update": "node scripts/artifact-update.mjs",
    "artifact-check": "node scripts/artifact-check.mjs",
    "sprint-update": "node scripts/sprint-update.mjs",
    "sprint-check": "node scripts/sprint-check.mjs",
    "version:bump": "node scripts/version-bump.mjs",
    "push-ready": "node scripts/push-ready.mjs",
    "prepush:local": "node scripts/prepush-local.mjs",
    "prepare": "husky",
    "prisma:validate": "prisma validate --schema database/prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema database/prisma/schema.prisma",
    "db:seed": "node database/seed/development.mjs",
    "forecast:validate-data": "tsx backend/src/scripts/forecastValidateData.ts",
    "forecast:import": "npm run forecast:validate-data",
    "forecast:generate": "tsx backend/src/scripts/forecastGenerate.ts",
    "forecast:smoke": "tsx backend/src/scripts/forecastSmoke.ts",
    "forecast:test": "python -m pytest forecasting-service/tests",
    "forecast:ui-test": "tsx --tsconfig frontend/tsconfig.app.json scripts/forecast-ui-test.ts",
    "product-names:repair": "tsx backend/src/scripts/repairProductNames.ts",
    "product-names:test": "tsx scripts/product-name-normalizer-test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "prisma": "^6.2.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  }
}
