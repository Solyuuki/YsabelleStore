{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "baseUrl": ".",
    "checkJs": false,
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "@/*": ["frontend/src/*"]
    },
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts"]
}
