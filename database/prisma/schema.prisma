  normalizedBarcode String?                    @map("normalized_barcode") @db.VarChar(80)
  normalizedPeriod  DateTime?                  @map("normalized_period") @db.Date
  quantitySold      Int?                       @map("quantity_sold") @db.UnsignedInt
  unitPrice         Decimal?                   @map("unit_price") @db.Decimal(10, 2)
  salesAmount       Decimal?                   @map("sales_amount") @db.Decimal(12, 2)
  status            HistoricalSalesRowStatus
  errorCode         String?                    @map("error_code") @db.VarChar(80)
  errorMessage      String?                    @map("error_message") @db.VarChar(500)
  warningCodes      Json?                      @map("warning_codes")
  matchedProductId  String?                    @map("matched_product_id") @db.VarChar(191)
  createdAt         DateTime                   @default(now()) @map("created_at")
  importBatch       HistoricalSalesImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  matchedProduct    Product?                   @relation(fields: [matchedProductId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([importBatchId, rowNumber], map: "uq_historical_import_row_number")
  @@index([importBatchId, status, rowNumber], map: "idx_historical_import_rows_batch_status_row")
  @@index([matchedProductId, normalizedPeriod], map: "idx_historical_import_rows_product_period")
  @@map("historical_sales_import_rows")
}

model RecommendationRecord {
  id                  String                 @id @default(cuid()) @db.VarChar(191)
  productId           String                 @map("product_id") @db.VarChar(191)
  forecastRecordId    String?                @map("forecast_record_id") @db.VarChar(191)
  generatedById       String?                @map("generated_by_id") @db.VarChar(191)
  type                RecommendationType
  severity            RecommendationSeverity @default(MEDIUM)
  recommendedQuantity Int?                   @map("recommended_quantity") @db.UnsignedInt
  reason              String                 @db.Text
  status              RecommendationStatus   @default(OPEN)
  generatedAt         DateTime               @default(now()) @map("generated_at")
  resolvedAt          DateTime?               @map("resolved_at")
  createdAt           DateTime               @default(now()) @map("created_at")
  product             Product                @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  forecastRecord      ForecastRecord?        @relation(fields: [forecastRecordId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  generatedBy         User?                  @relation(fields: [generatedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([productId, severity], map: "idx_recommendations_product_severity")
  @@index([type, status], map: "idx_recommendations_type_status")
  @@index([forecastRecordId], map: "idx_recommendations_forecast")
  @@index([generatedAt], map: "idx_recommendations_generated_at")
  @@index([generatedById], map: "idx_recommendations_generated_by")
  @@map("recommendation_records")
}
