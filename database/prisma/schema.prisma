// ==================================================
// YsabelleStore Sprint 1 Database Foundation
// ==================================================
//
// Scope:
// - Define the approved core data model for future product, inventory, sales,
//   forecasting, recommendation, and local authentication modules.
// - Keep this schema focused on persistence contracts only.
// - Do not add feature CRUD behavior, SARIMA execution, or recommendation logic here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CustomerAccountStatus {
  ACTIVE
  INACTIVE
}

enum CustomerSocialProvider {
  GOOGLE
  FACEBOOK
}

enum CustomerOAuthTransport {
  WEB
  ELECTRON
}

enum ProductUnit {
  PIECE
  PACK
  BOX
  BOTTLE
  SACHET
  KILOGRAM
  GRAM
  LITER
  MILLILITER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum CatalogRecordSource {
  CATALOG
  IMPORT
  TEST_FIXTURE
  INTERNAL
}

enum CatalogQualityStatus {
  APPROVED
  NEEDS_REVIEW
  REJECTED
}

enum ProductImageQualityStatus {
  APPROVED
  NEEDS_REVIEW
  REJECTED
}

enum ProductImageProcessingStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum ProductSizeUnit {
  MILLILITER
  LITER
  GRAM
  KILOGRAM
  PIECE
}

enum ProductAliasType {
  RAW_NAME
  SKU
  BARCODE
  SUPPLIER_CODE
}

enum ProductIdentityMatchType {
  BARCODE
  SKU
  SUPPLIER_CODE
  NORMALIZED_IDENTITY
  MANUAL_REVIEW
}

enum ProductMappingAction {
  MAPPED
  MERGED
}

enum ProductDuplicateStatus {
  PENDING
  CONFIRMED
  REJECTED
  MERGED
}

enum SarimaSourceIdentityConfidence {
  HIGH
  MEDIUM
  LOW
}

enum InventoryBatchStatus {
  AVAILABLE
  LOW_STOCK
  DEPLETED
  EXPIRED
  REMOVED
}

enum InventoryMovementType {
  STOCK_IN
  SALE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN_IN
  RETURN_OUT
  DAMAGE
  EXPIRED
  INITIAL_STOCK
  STOCK_OUT
  ADJUSTMENT
  RETURN
  DAMAGED
}

enum SaleStatus {
  DRAFT
  COMPLETED
  VOIDED
}

enum CustomerOrderStatus {
  PENDING
  CONFIRMED
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum CustomerFulfillmentMethod {
  STORE_PICKUP
}

enum CustomerPaymentMethod {
  CASH_ON_PICKUP
}

enum ForecastStatus {
  PENDING
  GENERATED
  FAILED
}

enum HistoricalSalesImportMode {
  APPEND_ONLY
  REJECT_ON_OVERLAP
  REPLACE_IMPORTED_OVERLAPS
}

enum HistoricalSalesImportStatus {
  PREVIEWED
  PROCESSING
  COMPLETED
  COMPLETED_WITH_SKIPS
  FAILED
  ROLLED_BACK
}

enum HistoricalSalesRowStatus {
  VALID
  WARNING
  INVALID
  UNMATCHED
  DUPLICATE
  OVERLAP
  IMPORTED
  SKIPPED
  REPLACED
}

enum MonthlySalesSource {
  IMPORTED_HISTORICAL
  POS_ACTUAL
  DEVELOPMENT_FIXTURE
}

enum ForecastRefreshStatus {
  NOT_REQUIRED
  PENDING
  SUCCEEDED
  FAILED
}

enum ForecastBatchStatus {
  GENERATING
  READY
  FAILED
  SUPERSEDED
  EMPTY
}

enum ForecastBatchSource {
  DATABASE
  WORKBOOK_FALLBACK
  EMPTY
}

enum RecommendationType {
  RESTOCK
  LOW_STOCK
  OVERSTOCK
  NEAR_EXPIRY
  EXPIRY_RISK
}

enum RecommendationSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RecommendationStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

model User {
  id                       String                       @id @default(cuid()) @db.VarChar(191)
  name                     String                       @db.VarChar(120)
  email                    String                       @unique(map: "uq_users_email") @db.VarChar(191)
  passwordHash             String                       @map("password_hash") @db.VarChar(255)
  role                     UserRole                     @default(STAFF)
  status                   UserStatus                   @default(ACTIVE)
  createdAt                DateTime                     @default(now()) @map("created_at")
  updatedAt                DateTime                     @updatedAt @map("updated_at")
  sales                    Sale[]
  inventoryMovements       InventoryMovement[]
  forecastRecords          ForecastRecord[]
  recommendationNotes      RecommendationRecord[]
  trustedDevices           TrustedDevice[]
  historicalSalesImports   HistoricalSalesImportBatch[] @relation("HistoricalSalesImportedBy")
  historicalSalesRollbacks HistoricalSalesImportBatch[] @relation("HistoricalSalesRolledBackBy")
  invalidatedMonthlySales  HistoricalMonthlySales[]     @relation("HistoricalSalesInvalidatedBy")

  @@index([role, status], map: "idx_users_role_status")
  @@map("users")
}

model TrustedDevice {
  id          String    @id @default(cuid()) @db.VarChar(191)
  userId      String    @map("user_id") @db.VarChar(191)
  tokenHash   String    @unique(map: "uq_trusted_devices_token_hash") @map("token_hash") @db.VarChar(64)
  deviceLabel String?   @map("device_label") @db.VarChar(120)
  userAgent   String?   @map("user_agent") @db.VarChar(255)
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId], map: "idx_trusted_devices_user_id")
  @@index([expiresAt], map: "idx_trusted_devices_expires_at")
  @@index([revokedAt], map: "idx_trusted_devices_revoked_at")
  @@map("trusted_devices")
}

model CustomerAccount {
  id              String                @id @default(cuid()) @db.VarChar(191)
  name            String                @db.VarChar(120)
  username        String?               @unique(map: "uq_customer_accounts_username") @db.VarChar(30)
  email           String                @unique(map: "uq_customer_accounts_email") @db.VarChar(191)
  phone           String?               @db.VarChar(40)
  phoneNormalized String?               @unique(map: "uq_customer_accounts_phone_normalized") @map("phone_normalized") @db.VarChar(16)
  emailVerifiedAt DateTime?             @map("email_verified_at")
  phoneVerifiedAt DateTime?             @map("phone_verified_at")
  passwordHash    String?               @map("password_hash") @db.VarChar(255)
  status          CustomerAccountStatus @default(ACTIVE)
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  sessions            CustomerSession[]
  passwordResetTokens CustomerPasswordResetToken[]
  socialIdentities    CustomerSocialIdentity[]
  socialLinkIntents   CustomerSocialLinkIntent[]
  oauthHandoffs       CustomerOAuthHandoff[]
  orders              CustomerOrder[]

  @@index([status], map: "idx_customer_accounts_status")
  @@map("customer_accounts")
}

model CustomerMobileAuthChallenge {
  id                String    @id @default(cuid()) @db.VarChar(191)
  customerAccountId String?   @map("customer_account_id") @db.VarChar(191)
  phoneNormalized   String    @map("phone_normalized") @db.VarChar(16)
  otpHash           String    @map("otp_hash") @db.VarChar(64)
  expiresAt         DateTime  @map("expires_at")
  consumedAt        DateTime? @map("consumed_at")
  failedAttempts    Int       @default(0) @map("failed_attempts") @db.UnsignedInt
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([phoneNormalized, createdAt], map: "idx_customer_mobile_auth_challenges_phone_created")
  @@index([customerAccountId], map: "idx_customer_mobile_auth_challenges_customer")
  @@index([expiresAt], map: "idx_customer_mobile_auth_challenges_expires")
  @@index([consumedAt], map: "idx_customer_mobile_auth_challenges_consumed")
  @@map("customer_mobile_auth_challenges")
}

model CustomerMobileRegistrationChallenge {
  id                     String    @id @db.VarChar(191)
  registrationIntentHash String    @map("registration_intent_hash") @db.VarChar(64)
  phoneNormalized        String    @map("phone_normalized") @db.VarChar(16)
  otpHash                String    @map("otp_hash") @db.VarChar(64)
  expiresAt              DateTime  @map("expires_at")
  consumedAt             DateTime? @map("consumed_at")
  failedAttempts         Int       @default(0) @map("failed_attempts") @db.UnsignedInt
  createdAt              DateTime  @default(now()) @map("created_at")

  @@index([registrationIntentHash, createdAt], map: "idx_customer_mobile_registration_intent_created")
  @@index([phoneNormalized, createdAt], map: "idx_customer_mobile_registration_phone_created")
  @@index([expiresAt], map: "idx_customer_mobile_registration_expires")
  @@index([consumedAt], map: "idx_customer_mobile_registration_consumed")
  @@map("customer_mobile_registration_challenges")
}

model CustomerEmailRegistrationChallenge {
  id                     String    @id @db.VarChar(191)
  registrationIntentHash String    @map("registration_intent_hash") @db.VarChar(64)
  emailNormalized        String    @map("email_normalized") @db.VarChar(191)
  otpHash                String    @map("otp_hash") @db.VarChar(64)
  expiresAt              DateTime  @map("expires_at")
  consumedAt             DateTime? @map("consumed_at")
  failedAttempts         Int       @default(0) @map("failed_attempts") @db.UnsignedInt
  createdAt              DateTime  @default(now()) @map("created_at")

  @@index([registrationIntentHash, createdAt], map: "idx_customer_email_registration_intent_created")
  @@index([emailNormalized, createdAt], map: "idx_customer_email_registration_email_created")
  @@index([expiresAt], map: "idx_customer_email_registration_expires")
  @@index([consumedAt], map: "idx_customer_email_registration_consumed")
  @@map("customer_email_registration_challenges")
}

model CustomerEmailAuthChallenge {
  id                String    @id @default(cuid()) @db.VarChar(191)
  customerAccountId String?   @map("customer_account_id") @db.VarChar(191)
  emailNormalized   String    @map("email_normalized") @db.VarChar(191)
  otpHash           String    @map("otp_hash") @db.VarChar(64)
  expiresAt         DateTime  @map("expires_at")
  consumedAt        DateTime? @map("consumed_at")
  failedAttempts    Int       @default(0) @map("failed_attempts") @db.UnsignedInt
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([emailNormalized, createdAt], map: "idx_customer_email_auth_email_created")
  @@index([customerAccountId], map: "idx_customer_email_auth_customer")
  @@index([expiresAt], map: "idx_customer_email_auth_expires")
  @@index([consumedAt], map: "idx_customer_email_auth_consumed")
  @@map("customer_email_auth_challenges")
}

model CustomerSocialIdentity {
  id                    String                 @id @default(cuid()) @db.VarChar(191)
  customerAccountId     String                 @map("customer_account_id") @db.VarChar(191)
  provider              CustomerSocialProvider
  providerSubject       String                 @map("provider_subject") @db.VarChar(191)
  providerEmail         String?                @map("provider_email") @db.VarChar(191)
  providerEmailVerified Boolean                @default(false) @map("provider_email_verified")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  customerAccount       CustomerAccount        @relation(fields: [customerAccountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([provider, providerSubject], map: "uq_customer_social_identities_provider_subject")
  @@unique([customerAccountId, provider], map: "uq_customer_social_identities_customer_provider")
  @@index([providerEmail], map: "idx_customer_social_identities_email")
  @@map("customer_social_identities")
}

model CustomerSocialLinkIntent {
  id                String                 @id @default(cuid()) @db.VarChar(191)
  customerAccountId String                 @map("customer_account_id") @db.VarChar(191)
  tokenHash         String                 @unique(map: "uq_customer_social_link_intents_token_hash") @map("token_hash") @db.VarChar(64)
  provider          CustomerSocialProvider
  providerSubject   String                 @map("provider_subject") @db.VarChar(191)
  providerEmail     String                 @map("provider_email") @db.VarChar(191)
  expiresAt         DateTime               @map("expires_at")
  usedAt            DateTime?              @map("used_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  customerAccount   CustomerAccount        @relation(fields: [customerAccountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([customerAccountId], map: "idx_customer_social_link_intents_customer")
  @@index([expiresAt], map: "idx_customer_social_link_intents_expires")
  @@index([usedAt], map: "idx_customer_social_link_intents_used")
  @@map("customer_social_link_intents")
}

model CustomerOAuthTransaction {
  id                     String                 @id @default(cuid()) @db.VarChar(191)
  provider               CustomerSocialProvider
  transport              CustomerOAuthTransport
  stateHash              String                 @unique(map: "uq_customer_oauth_transactions_state_hash") @map("state_hash") @db.VarChar(64)
  browserBindingHash     String?                @map("browser_binding_hash") @db.VarChar(64)
  pkceVerifierCiphertext String                 @map("pkce_verifier_ciphertext") @db.Text
  nonceCiphertext        String?                @map("nonce_ciphertext") @db.Text
  nonceHash              String?                @map("nonce_hash") @db.VarChar(64)
  electronChallenge      String?                @map("electron_challenge") @db.VarChar(86)
  returnPath             String                 @default("/") @map("return_path") @db.VarChar(255)
  expiresAt              DateTime               @map("expires_at")
  consumedAt             DateTime?              @map("consumed_at")
  createdAt              DateTime               @default(now()) @map("created_at")

  @@index([expiresAt], map: "idx_customer_oauth_transactions_expires")
  @@index([consumedAt], map: "idx_customer_oauth_transactions_consumed")
  @@map("customer_oauth_transactions")
}

model CustomerOAuthHandoff {
  id                String          @id @default(cuid()) @db.VarChar(191)
  customerAccountId String          @map("customer_account_id") @db.VarChar(191)
  codeHash          String          @unique(map: "uq_customer_oauth_handoffs_code_hash") @map("code_hash") @db.VarChar(64)
  verifierChallenge String          @map("verifier_challenge") @db.VarChar(86)
  expiresAt         DateTime        @map("expires_at")
  usedAt            DateTime?       @map("used_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([customerAccountId], map: "idx_customer_oauth_handoffs_customer")
  @@index([expiresAt], map: "idx_customer_oauth_handoffs_expires")
  @@index([usedAt], map: "idx_customer_oauth_handoffs_used")
  @@map("customer_oauth_handoffs")
}

model CustomerPasswordResetToken {
  id                String          @id @default(cuid()) @db.VarChar(191)
  customerAccountId String          @map("customer_account_id") @db.VarChar(191)
  tokenHash         String          @unique(map: "uq_customer_password_reset_tokens_token_hash") @map("token_hash") @db.VarChar(64)
  expiresAt         DateTime        @map("expires_at")
  usedAt            DateTime?       @map("used_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([customerAccountId], map: "idx_customer_password_reset_tokens_customer")
  @@index([expiresAt], map: "idx_customer_password_reset_tokens_expires")
  @@index([usedAt], map: "idx_customer_password_reset_tokens_used")
  @@map("customer_password_reset_tokens")
}

model CustomerSession {
  id                String          @id @default(cuid()) @db.VarChar(191)
  customerAccountId String          @map("customer_account_id") @db.VarChar(191)
  tokenHash         String          @unique(map: "uq_customer_sessions_token_hash") @map("token_hash") @db.VarChar(64)
  expiresAt         DateTime        @map("expires_at")
  revokedAt         DateTime?       @map("revoked_at")
  lastUsedAt        DateTime?       @map("last_used_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([customerAccountId], map: "idx_customer_sessions_customer")
  @@index([expiresAt], map: "idx_customer_sessions_expires")
  @@index([revokedAt], map: "idx_customer_sessions_revoked")
  @@map("customer_sessions")
}

model Category {
  id                  String               @id @default(cuid()) @db.VarChar(191)
  name                String               @unique(map: "uq_categories_name") @db.VarChar(120)
  slug                String               @unique(map: "uq_categories_slug") @db.VarChar(140)
  description         String?              @db.VarChar(255)
  isActive            Boolean              @default(true) @map("is_active")
  recordSource        CatalogRecordSource  @default(CATALOG) @map("record_source")
  dataQualityStatus   CatalogQualityStatus @default(NEEDS_REVIEW) @map("data_quality_status")
  isStorefrontVisible Boolean              @default(false) @map("is_storefront_visible")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  products            Product[]

  @@index([isActive], map: "idx_categories_is_active")
  @@index([isStorefrontVisible, dataQualityStatus, isActive], map: "idx_categories_storefront_quality")
  @@map("categories")
}

model Product {
  id                        String                      @id @default(cuid()) @db.VarChar(191)
  categoryId                String                      @map("category_id") @db.VarChar(191)
  activeImageAssetId        String?                     @unique(map: "uq_products_active_image_asset") @map("active_image_asset_id") @db.VarChar(191)
  sku                       String                      @unique(map: "uq_products_sku") @db.VarChar(80)
  barcode                   String?                     @unique(map: "uq_products_barcode") @db.VarChar(80)
  name                      String                      @db.VarChar(160)
  description               String?                     @db.VarChar(255)
  imageUrl                  String?                     @map("image_url") @db.VarChar(2048)
  brand                     String?                     @db.VarChar(120)
  variant                   String?                     @db.VarChar(120)
  sizeValue                 Decimal?                    @map("size_value") @db.Decimal(10, 3)
  sizeUnit                  ProductSizeUnit?            @map("size_unit")
  unit                      ProductUnit                 @default(PIECE)
  costPrice                 Decimal?                    @map("cost_price") @db.Decimal(10, 2)
  sellingPrice              Decimal                     @map("selling_price") @db.Decimal(10, 2)
  reorderLevel              Int                         @default(0) @map("reorder_level") @db.UnsignedInt
  targetStockLevel          Int                         @default(0) @map("target_stock_level") @db.UnsignedInt
  status                    ProductStatus               @default(ACTIVE)
  recordSource              CatalogRecordSource         @default(CATALOG) @map("record_source")
  dataQualityStatus         CatalogQualityStatus        @default(NEEDS_REVIEW) @map("data_quality_status")
  isStorefrontVisible       Boolean                     @default(false) @map("is_storefront_visible")
  createdAt                 DateTime                    @default(now()) @map("created_at")
  updatedAt                 DateTime                    @updatedAt @map("updated_at")
  category                  Category                    @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  activeImageAsset          ProductImageAsset?          @relation("ActiveProductImage", fields: [activeImageAssetId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  imageAssets               ProductImageAsset[]         @relation("ProductImageAssets")
  inventory                 Inventory?
  inventoryBatches          InventoryBatch[]
  inventoryMovements        InventoryMovement[]
  saleItems                 SaleItem[]
  forecastRecords           ForecastRecord[]
  recommendationRecords     RecommendationRecord[]
  historicalMonthlySales    HistoricalMonthlySales[]
  historicalSalesImportRows HistoricalSalesImportRow[]
  customerOrderItems        CustomerOrderItem[]
  reviews                   ProductReview[]
  aliases                   ProductAlias[]
  sourceMapping             ProductCanonicalMapping?    @relation("SourceProductMapping")
  canonicalMappings         ProductCanonicalMapping[]   @relation("CanonicalProductMappings")
  sarimaSourceMapping       SarimaSourceProductMapping?
  duplicateCandidatesLeft   ProductDuplicateCandidate[] @relation("DuplicateCandidateLeft")
  duplicateCandidatesRight  ProductDuplicateCandidate[] @relation("DuplicateCandidateRight")
  canonicalAuditLogs        CatalogAuditLog[]

  @@index([categoryId, status], map: "idx_products_category_status")
  @@index([name], map: "idx_products_name")
  @@index([status, createdAt], map: "idx_products_status_created")
  @@index([isStorefrontVisible, dataQualityStatus, status], map: "idx_products_storefront_quality")
  @@index([recordSource, dataQualityStatus], map: "idx_products_source_quality")
  @@map("products")
}

model ProductImageAsset {
  id                  String                       @id @default(cuid()) @db.VarChar(191)
  productId           String                       @map("product_id") @db.VarChar(191)
  qualityStatus       ProductImageQualityStatus    @default(NEEDS_REVIEW) @map("quality_status")
  processingStatus    ProductImageProcessingStatus @default(PENDING) @map("processing_status")
  originalStorageKey  String                       @map("original_storage_key") @db.VarChar(500)
  processedStorageKey String?                      @map("processed_storage_key") @db.VarChar(500)
  cardStorageKey      String?                      @map("card_storage_key") @db.VarChar(500)
  pdpStorageKey       String?                      @map("pdp_storage_key") @db.VarChar(500)
  sourceMimeType      String                       @map("source_mime_type") @db.VarChar(80)
  sourceBytes         Int                          @map("source_bytes") @db.UnsignedInt
  sourceWidth         Int?                         @map("source_width") @db.UnsignedInt
  sourceHeight        Int?                         @map("source_height") @db.UnsignedInt
  diagnostics         Json?
  processingVersion   String                       @default("ciqe-v1") @map("processing_version") @db.VarChar(40)
  approvedAt          DateTime?                    @map("approved_at")
  rejectedAt          DateTime?                    @map("rejected_at")
  supersededAt        DateTime?                    @map("superseded_at")
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @updatedAt @map("updated_at")
  product             Product                      @relation("ProductImageAssets", fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  activeForProduct    Product?                     @relation("ActiveProductImage")

  @@index([productId, createdAt], map: "idx_product_image_assets_product_created")
  @@index([productId, qualityStatus, processingStatus], map: "idx_product_image_assets_quality")
  @@map("product_image_assets")
}

model ProductReview {
  id                  String   @id @default(cuid()) @db.VarChar(191)
  productId           String   @map("product_id") @db.VarChar(191)
  reviewerDisplayName String   @map("reviewer_display_name") @db.VarChar(120)
  rating              Int      @db.UnsignedTinyInt
  comment             String   @db.VarChar(1000)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([productId, createdAt], map: "idx_product_reviews_product_created")
  @@index([productId, rating, createdAt], map: "idx_product_reviews_product_rating_created")
  @@map("product_reviews")
}

model ProductAlias {
  id                 String              @id @default(cuid()) @db.VarChar(191)
  canonicalProductId String              @map("canonical_product_id") @db.VarChar(191)
  type               ProductAliasType
  value              String              @db.VarChar(255)
  normalizedValue    String              @map("normalized_value") @db.VarChar(255)
  recordSource       CatalogRecordSource @default(IMPORT) @map("record_source")
  sourceReference    String?             @map("source_reference") @db.VarChar(255)
  evidence           Json?
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  canonicalProduct   Product             @relation(fields: [canonicalProductId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([canonicalProductId, type, normalizedValue], map: "uq_product_alias_identity")
  @@index([type, normalizedValue], map: "idx_product_alias_lookup")
  @@map("product_aliases")
}

model ProductCanonicalMapping {
  id                 String                   @id @default(cuid()) @db.VarChar(191)
  sourceProductId    String                   @unique(map: "uq_product_mapping_source") @map("source_product_id") @db.VarChar(191)
  canonicalProductId String                   @map("canonical_product_id") @db.VarChar(191)
  matchType          ProductIdentityMatchType @map("match_type")
  action             ProductMappingAction     @default(MAPPED)
  reason             String                   @db.VarChar(500)
  evidence           Json
  automated          Boolean                  @default(false)
